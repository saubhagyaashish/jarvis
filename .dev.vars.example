# Local secrets for `npm run dev`. Copy this file to .dev.vars (gitignored)
# and fill in the value. In production, set it with:
#   npx wrangler secret put OLLAMA_API_KEY
#
# Optional: Ollama Cloud key, used only when Workers AI's free daily limit
# is used up. Leave empty to disable the fallback.
OLLAMA_API_KEY=
