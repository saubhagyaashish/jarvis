{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "JarvisAgent",
        "name": "JarvisAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["JarvisAgent"],
      "tag": "v1"
    }
  ],
  // Backup model while Workers AI's free daily limit is used up. The key is a
  // secret: `npx wrangler secret put OLLAMA_API_KEY` (and .dev.vars locally).
  "vars": { "OLLAMA_MODEL": "gpt-oss:120b" },
  "workflows": [
    {
      "name": "morning-briefing",
      "binding": "BRIEFING_WORKFLOW",
      "class_name": "MorningBriefingWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
